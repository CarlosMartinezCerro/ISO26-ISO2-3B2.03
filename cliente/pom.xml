<!-- cliente/pom.xml -->
<project>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>es.uclm.esi.iso2.3B2.03</groupId>
        <artifactId>radiodiagnostico</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>cliente</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Arranque del cliente: mvn -pl cliente javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>es.uclm.esi.iso2.radiodiagnostico.AplicacionCliente</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
